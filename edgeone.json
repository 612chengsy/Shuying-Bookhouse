{
  "name": "Shuying-Bookhouse",
  "version": "1.0.0",
  "routes": [
    {
      "path": "/api/*",
      "function": "edge-functions/index.js"
    }
  ],
  "static": {
    "dir": ".",
    "fallback": "index.html"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "entry": "edge-functions/index.ts"
  }
}